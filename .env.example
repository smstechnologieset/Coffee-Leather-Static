# Copy this file to .env.local in the repo root AND in each app directory.
# Never commit real keys.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Found at: Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here   # server-side only, never expose to browser

# ── Site URLs (used for cross-site links) ─────────────────────────────────────
NEXT_PUBLIC_MAIN_SITE_URL=http://localhost:3000
NEXT_PUBLIC_COFFEE_SITE_URL=http://localhost:3001
NEXT_PUBLIC_LEATHER_SITE_URL=http://localhost:3002
