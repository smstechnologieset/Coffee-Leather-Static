{
  "name": "highland-roots-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "shared",
    "main-site",
    "coffee-site",
    "leather-site"
  ],
  "scripts": {
    "dev:main": "npm run dev --workspace=main-site",
    "dev:coffee": "npm run dev --workspace=coffee-site",
    "dev:leather": "npm run dev --workspace=leather-site",
    "build:all": "npm run build --workspaces --if-present",
    "lint:all": "npm run lint --workspaces --if-present"
  }
}
